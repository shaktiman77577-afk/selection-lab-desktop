{
  "name": "selection-lab-desktop",
  "productName": "Selection Lab",
  "version": "1.0.0",
  "description": "Selection Lab desktop app for Windows",
  "author": "Selection Lab",
  "homepage": "https://www.selectionlab.in",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/security.js && node --check src/login.js && node --check src/updater.js && node --check src/store.js",
    "dist:win": "electron-builder --win --publish never",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.selectionlab.desktop",
    "productName": "Selection Lab",
    "copyright": "Copyright © 2026 Selection Lab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "protocols": [
      {
        "name": "Selection Lab",
        "schemes": [
          "selectionlab"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SelectionLab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Selection Lab",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shaktiman77577-afk",
        "repo": "selection-lab-desktop",
        "releaseType": "release"
      }
    ]
  }
}
